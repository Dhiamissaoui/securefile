# Copier ce fichier vers backend/.env
PORT=5000
MONGO_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=securefile_v2
CLIENT_ORIGIN=http://localhost:5173

# Générer chaque valeur avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne plus les modifier après le premier npm run seed.
JWT_SECRET=change-me
HMAC_KEY=change-me
CA_PASSPHRASE=change-me

NODE_ENV=development
